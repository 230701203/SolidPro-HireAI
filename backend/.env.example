# Copy to .env and edit. NEVER commit .env.

APP_NAME="SolidPro HireAI"
ENVIRONMENT=development            # development | test | production

# --- Database (PostgreSQL) ---
DATABASE_URL=DATABASE_URL=postgresql://username:password@localhost:5432/hireai

# --- Security ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_secure_secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
REMEMBER_ME_EXPIRE_MINUTES=43200   # 30 days
COOKIE_NAME=hireai_session
COOKIE_SECURE=false                # must be true in production (HTTPS)
COOKIE_SAMESITE=lax
RATE_LIMIT_ENABLED=true
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- URLs --
FRONTEND_URL=http://localhost:5173           # used to build links in emails
CORS_ORIGINS=http://localhost:5173           # comma separated

# --- Email (SMTP). Leave SMTP_HOST empty in development to log emails instead. ---
SMTP_HOST=localhost
SMTP_PORT=1025                               # Mailpit default
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM="SolidPro HireAI <no-reply@solidpro.example>"
SUPPORT_EMAIL=hr-support@solidpro.example

# --- Company email domains (seeds the allowlist on first bootstrap; admins can edit later) ---
COMPANY_EMAIL_DOMAINS=solidpro.example

# --- Initial administrator (used only by `python -m app.cli bootstrap`) ---
ADMIN_EMAIL=admin@solidpro.example
ADMIN_NAME="System Administrator"
# If empty, a random password is generated and printed ONCE. Admin must change it at first login.
ADMIN_INITIAL_PASSWORD=
