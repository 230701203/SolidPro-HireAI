# Copy to .env and edit. NEVER commit .env.

APP_NAME="SolidPro HireAI"
ENVIRONMENT=development            # development | test | production

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://hireai:hireai@localhost:5432/hireai

# --- Security ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=480
REMEMBER_ME_EXPIRE_MINUTES=43200   # 30 days
COOKIE_NAME=hireai_session
COOKIE_SECURE=false                # must be true in production (HTTPS)
COOKIE_SAMESITE=lax
RATE_LIMIT_ENABLED=true
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- URLs ---
FRONTEND_URL=http://localhost:5173           # used to build links in emails
CORS_ORIGINS=http://localhost:5173           # comma separated

# --- Email (SMTP). Leave SMTP_HOST empty in development to log emails instead. ---
SMTP_HOST=localhost
SMTP_PORT=1025                               # Mailpit default
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM="SolidPro HireAI <no-reply@solidpro.example>"
SUPPORT_EMAIL=hr-support@solidpro.example

# --- File storage (private; resumes and, later, audio recordings). Keep OUTSIDE any web root. ---
UPLOAD_DIR=./storage
MAX_UPLOAD_MB=5
BULK_MAX_FILES=50                  # resumes per bulk-screening batch
BULK_MAX_ATTEMPTS=3                # automatic retries per file before it is marked failed

# --- Company email domains (seeds the allowlist on first bootstrap; admins can edit later) ---
AI_PROVIDER=mock                   # mock | anthropic. Mock is keyword matching, clearly labelled in the UI
ANTHROPIC_API_KEY=                 # only needed when AI_PROVIDER=anthropic; never commit it
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_SECONDS=60
# --- Speech-to-text for Repeat the Sentence ---
STT_PROVIDER=mock                  # mock (cannot understand audio; every recording needs a human) | openai
STT_API_KEY=
STT_MODEL=whisper-1
STT_BASE_URL=https://api.openai.com/v1
STT_MIN_CONFIDENCE=0.6             # below this a transcript is flagged for a person to listen

# --- Online testing ---
SWEEPER_ENABLED=true               # auto-submit overdue attempts / expire missed schedules (disable on extra instances)
SWEEPER_INTERVAL_SECONDS=60
REVIEW_REMINDER_AFTER_HOURS=24     # a draft evaluation waiting longer than this triggers a reminder to reviewers
REVIEW_REMINDER_EVERY_HOURS=24     # at most one reminder per person in this period
SUBMIT_GRACE_SECONDS=20
MAX_RECORDING_MB=8
COMPANY_EMAIL_DOMAINS=solidpro.example

# --- Initial administrator (used only by `python -m app.cli bootstrap`) ---
ADMIN_EMAIL=admin@solidpro.example
ADMIN_NAME="System Administrator"
# If empty, a random password is generated and printed ONCE. Admin must change it at first login.
ADMIN_INITIAL_PASSWORD=
